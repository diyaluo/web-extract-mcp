{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.diyaluo/web-extract-mcp",
  "description": "Local HTML to structured extraction MCP server (links, tables, title, body), offline.",
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/diyaluo/web-extract-mcp:v0.1.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "docker",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "run"
        },
        {
          "type": "positional",
          "value": "-i"
        },
        {
          "type": "positional",
          "value": "--rm"
        },
        {
          "type": "positional",
          "value": "ghcr.io/diyaluo/web-extract-mcp:v0.1.0"
        }
      ]
    }
  ],
  "tools": [
    {
      "name": "extract_page"
    },
    {
      "name": "extract_batch"
    }
  ]
}